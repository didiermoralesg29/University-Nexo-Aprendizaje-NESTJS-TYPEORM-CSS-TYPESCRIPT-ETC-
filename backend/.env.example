# Copia este archivo como .env y completa los valores

# ---- Servidor ----
PORT=3000

# ---- Base de datos PostgreSQL ----
DB_HOST=localhost
DB_PUERTO=5432
DB_USUARIO=postgres
DB_CONTRASENA=tu_contraseña_de_postgres
DB_NOMBRE=nexo_university
# true = borra y vuelve a crear todas las tablas al arrancar (se pierden los datos)
DB_REINICIAR=false

# ---- Autenticación ----
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRETO=cambia_esto_por_una_clave_larga_y_aleatoria
